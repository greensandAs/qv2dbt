      "fact_*",
      "dim_*",
      "fact*",
      "dim*",
      "*fact",
      "*_report",
      "*_kpi",
      "*summary"
    ]
  },
  "functions": {
    "if": "CASE WHEN {0} THEN {1} ELSE {2} END",
    "alt": "COALESCE({*})",
    "isnull": "{0} IS NULL",
    "nullasvalue": "COALESCE({0}, {1})",
    "left": "LEFT({0}, {1})",
    "right": "RIGHT({0}, {1})",
    "mid": "SUBSTR({0}, {1}, {2})",
    "len": "LENGTH({0})",
    "upper": "UPPER({0})",
    "lower": "LOWER({0})",
    "trim": "TRIM({0})",
    "ltrim": "LTRIM({0})",
    "rtrim": "RTRIM({0})",
    "index": "POSITION({1} IN {0})",
    "subfield": "SPLIT_PART({0}, {1}, {2})",
    "replace": "REPLACE({0}, {1}, {2})",
    "keepchar": "REGEXP_REPLACE({0}, '[^' || {1} || ']', '')",
    "num": "TO_NUMBER({0})",
    "round": "ROUND({*})",
    "floor": "FLOOR({0})",
    "ceil": "CEIL({0})",
    "abs": "ABS({0})",
    "fabs": "ABS({0})",
    "pow": "POWER({0}, {1})",
    "mod": "MOD({0}, {1})",
    "today": "CURRENT_DATE",
    "now": "CURRENT_TIMESTAMP",
    "date": {
      "1": "TO_DATE({0})",
      "2": "TO_DATE({0}, {1})"
    },
    "date#": {
      "1": "TO_DATE({0})",
      "2": "TO_DATE({0}, {1})"
    },
    "num#": "TO_NUMBER({0})",
    "makedate": "DATE_FROM_PARTS({*})",
    "year": "YEAR({0})",
    "month": "MONTH({0})",
    "day": "DAY({0})",
    "week": "WEEK({0})",
    "monthstart": "DATE_TRUNC('MONTH', {0})",
    "monthend": "LAST_DAY({0})",
    "yearstart": "DATE_TRUNC('YEAR', {0})",
    "addmonths": "DATEADD('MONTH', {1}, {0})",
    "sum": "SUM({0})",
    "count": "COUNT({0})",
    "avg": "AVG({0})",
    "min": "MIN({0})",
    "max": "MAX({0})",
    "only": "MIN({0})",
    "rangesum": "({*})",
    "median": "MEDIAN({0})",
    "stdev": "STDDEV({0})",
    "mode": "MODE({0})",
    "concat": "LISTAGG({0}, {1})",
    "capitalize": "INITCAP({0})",
    "purgechar": "REGEXP_REPLACE({0}, '[' || {1} || ']', '')",
    "chr": "CHR({0})",
    "ord": "ASCII({0})",
    "repeat": "REPEAT({0}, {1})",
    "text": "TO_VARCHAR({0})",
    "substringcount": "((LENGTH({0}) - LENGTH(REPLACE({0}, {1}, ''))) / NULLIF(LENGTH({1}), 0))",
    "sign": "SIGN({0})",
    "sqrt": "SQRT({0})",
    "exp": "EXP({0})",
    "log": "LN({0})",
    "log10": "LOG(10, {0})",
    "fmod": "MOD({0}, {1})",
    "div": "FLOOR({0} / {1})",
    "frac": "({0} - FLOOR({0}))",
    "even": "(MOD({0}, 2) = 0)",
    "odd": "(MOD({0}, 2) <> 0)",
    "rangemin": "LEAST({*})",
    "rangemax": "GREATEST({*})",
    "not": "NOT ({0})",
    "nullif": "NULLIF({0}, {1})",
    "rangecount": "({*})",
    "hash128": "MD5({0})",
    "hash256": "SHA2({0}, 256)",
    "autonumber": "DENSE_RANK() OVER (ORDER BY {0})",
    "monthname": "TO_CHAR({0}, 'YYYY-Mon')",
    "quartername": "'Q' || QUARTER({0}) || ' ' || YEAR({0})",
    "dayname": "TO_CHAR({0}, 'DY')",
    "textbetween": "REGEXP_SUBSTR({0}, REGEXP_REPLACE({1}, '(.)', '\\\\\\\\1') || '(.*)' || REGEXP_REPLACE({2}, '(.)', '\\\\\\\\1'), 1, 1, 'e')",
    "maketime": "TIME_FROM_PARTS({*})",
    "timestamp": {
      "1": "TO_TIMESTAMP({0})",
      "2": "TO_TIMESTAMP({0}, {1})"
    },
    "timestamp#": {
      "1": "TO_TIMESTAMP({0})",
      "2": "TO_TIMESTAMP({0}, {1})"
    },
    "hour": "HOUR({0})",
    "minute": "MINUTE({0})",
    "second": "SECOND({0})",
    "weekday": "DAYOFWEEK({0})",
    "weekstart": "DATE_TRUNC('WEEK', {0})",
    "quarterstart": "DATE_TRUNC('QUARTER', {0})",
    "quarterend": "LAST_DAY({0}, 'QUARTER')",
    "yearend": "LAST_DAY({0}, 'YEAR')",
    "addyears": "DATEADD('YEAR', {1}, {0})",
    "utc": "CURRENT_TIMESTAMP",
    "localtime": "CURRENT_TIMESTAMP"
  },
  "operators": {
    "&": "||",
    "=": "=",
    "<>": "<>",
